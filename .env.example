# SafeFare AI — frontend environment. Copy to .env.local and adjust.
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build time:
# never put secrets, credentials or server-only keys here.

# Safe-Fare Fleet BFF origin (no trailing slash, no /api/v1 suffix).
NEXT_PUBLIC_API_BASE_URL=https://safefareai-api.sconexsoft.com/safe-fare

# Per-request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Console request diagnostics (method, URL, status, duration, request id — never bodies or tokens).
# Defaults to on in `next dev` and off in production builds; set to "false" to silence in dev.
NEXT_PUBLIC_API_DEBUG=true

# Optional: prefill the tenant code on the sign-in screen (not a secret).
NEXT_PUBLIC_DEFAULT_TENANT_CODE=

# Geographic base map (Live Monitoring, Trips & Tracking) — MapLibre GL + MapTiler.
# This key is PUBLIC: the browser sends it with every style/tile request. Restrict it in the
# MapTiler dashboard (API keys → Allowed HTTP origins) to your app's origins, e.g.
# localhost:3000 for development and your production domain. Never use a service token here.
# Leave empty to use the coordinate-grid fallback (no requests to MapTiler).
NEXT_PUBLIC_MAPTILER_KEY=
# Optional MapTiler map id (default streets-v4).
NEXT_PUBLIC_MAPTILER_MAP=
# Optional full style URL that replaces MapTiler (self-hosted tiles); no key is sent when set.
NEXT_PUBLIC_MAP_STYLE_URL=

# Extra hosts allowed to serve alert evidence, comma-separated (not secret). gpstracktech.com and the API host are
# always allowed. Add a host here if real evidence shows "Host not approved".
NEXT_PUBLIC_EVIDENCE_MEDIA_HOSTS=

# Live camera popup on Live Monitoring (GPSTrackTech video player). PUBLIC: built into the browser bundle
# and sent in the player URL, so anyone using the app can read it. Use a token restricted to video playback.
# Leave empty to show "Live video isn't configured" in the popup.
NEXT_PUBLIC_GPS_VIDEO_API_TOKEN=d0df9868-40be-4337-a11b-05b9b492ccb1

# Safe-Fare Python API base URL (no trailing slash; keep the /safe-fare-python path). TEMPORARY DEMO INTEGRATION:
# the browser calls it DIRECTLY for Iris chat, Sensor Alerts and Vehicle / Tyre Maintenance, so it is PUBLIC (built
# into the bundle). Never put Python secrets or service credentials here. The Python host must allow this site's
# origin (CORS). HTTPS is required in production builds. The Safe-Fare token is never sent to it.
# Not used for the Java BFF (NEXT_PUBLIC_API_BASE_URL above) or the GPSTrackTech video service.
NEXT_PUBLIC_PYTHON_API_BASE_URL=https://safefareai-api.sconexsoft.com/safe-fare-python

# The one tenant the Python demo may use (tenant_id / X-Tenant-ID). Python features are shown only to users of this
# tenant (or the Safe-Fare Admin with it selected); everyone else sees "only available in the demo tenant".
# NOT CONFIRMED: 1 is the tenant in the Python samples and the "Synthetic Base Tenant"; confirm before a demo.
NEXT_PUBLIC_DEMO_TENANT_ID=1

# Passenger Analytics demo (Sensors screen: Sensor vs BMS, Stops, BMS records, Sensor readings). "true" adds a
# SIMULATED demo journey (bus TS09UB2180, 11 Nov 2026) to the Vehicle list, labelled DEMO DATA. Off by default; it
# never replaces live data, never writes, and is never shown when a live request fails.
NEXT_PUBLIC_PASSENGER_DEMO_MODE=false
