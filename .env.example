# SafeFare AI — frontend environment. Copy to .env.local and adjust.
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build time:
# never put secrets, credentials or server-only keys here.

# Safe-Fare Fleet BFF origin (no trailing slash, no /api/v1 suffix).
NEXT_PUBLIC_API_BASE_URL=http://185.193.19.156:9096

# Per-request timeout in milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Console request diagnostics (method, URL, status, duration, request id — never bodies or tokens).
# Defaults to on in `next dev` and off in production builds; set to "false" to silence in dev.
NEXT_PUBLIC_API_DEBUG=true

# Optional: prefill the tenant code on the sign-in screen (not a secret).
NEXT_PUBLIC_DEFAULT_TENANT_CODE=

# Geographic base map (Live Monitoring, Trips & Tracking) — MapLibre GL + MapTiler.
# This key is PUBLIC: the browser sends it with every style/tile request. Restrict it in the
# MapTiler dashboard (API keys → Allowed HTTP origins) to your app's origins, e.g.
# localhost:3000 for development and your production domain. Never use a service token here.
# Leave empty to use the coordinate-grid fallback (no requests to MapTiler).
NEXT_PUBLIC_MAPTILER_KEY=
# Optional MapTiler map id (default streets-v4).
NEXT_PUBLIC_MAPTILER_MAP=
# Optional full style URL that replaces MapTiler (self-hosted tiles); no key is sent when set.
NEXT_PUBLIC_MAP_STYLE_URL=
